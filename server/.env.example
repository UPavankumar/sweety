# Server configuration
PORT=5000

# PostgreSQL database connection (Neon or local)
# sslmode=verify-full keeps certificate checks on and silences pg's sslmode warning
DATABASE_URL=postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full

# JWT authentication secret (at least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_chars

# Browser origins allowed to call the API (comma-separated). Default: Vite dev server.
# CORS_ORIGIN=https://sweety.example.com

# Set to 1 when running behind a reverse proxy so rate limits see the real client IP
# TRUST_PROXY=1

# Optional rate-limit overrides
# LOGIN_RATE_LIMIT=10       # attempts per IP+email per 15 minutes
# REGISTER_RATE_LIMIT=20    # sign-ups per IP per hour
